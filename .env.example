# Copy to .env.local and adjust for your setup.

# Base URL the browser uses to fetch artwork variants (pre-built AVIF/WebP
# files + originals). Defaults (in code) to the rclone HTTP server run by
# the asset HTTP server (scripts/serve-assets.mjs) on :9837. Override to
# point at R2, a public CDN, or any other HTTP file host.
NEXT_PUBLIC_ASSETS_BASE_URL=http://localhost:9837

# Canonical site URL (used for artwork links in the email and absolute URLs
# in metadata / sitemaps / JSON-LD). Falls back to a hardcoded prod URL
# (or localhost in dev) if unset.
# NEXT_PUBLIC_SITE_URL=https://collection-of-beauty.example.com

# ─────────────────────────────────────────────────────────────────────────────
# Newsletter (Mailgun)
# ─────────────────────────────────────────────────────────────────────────────
# Editions live as markdown under content/newsletter/. There is no cron job
# and no /api/newsletter/send route. Sending happens via the CLI:
#   pnpm newsletter:send <slug>            # dry-run
#   pnpm newsletter:send <slug> --test     # → MAILGUN_TEST_LIST
#   pnpm newsletter:send <slug> --confirm  # → MAILGUN_LIST

# Mailgun account — used for sending editions and for the double-opt-in
# confirmation emails issued by /api/newsletter/subscribe.
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=mg.example.com
# MAILGUN_FROM="Collection of Beauty <digest@mg.example.com>"
# Real subscriber list — fanned out by Mailgun to every confirmed member.
# MAILGUN_LIST=weekly@mg.example.com
# Test list — a separate Mailgun mailing list containing only your own
# email address. `pnpm newsletter:send <slug> --test` sends here.
# MAILGUN_TEST_LIST=test@mg.example.com
# For EU accounts, uncomment:
# MAILGUN_API_URL=https://api.eu.mailgun.net

# HMAC secret for the double-opt-in confirmation tokens issued by
# /api/newsletter/subscribe. Generate with: openssl rand -hex 32
# NEWSLETTER_TOKEN_SECRET=

# Cloudflare R2 credentials — public assets bucket only (no state file
# any more; newsletter "has it been sent" lives in git via the markdown
# files in content/newsletter/).
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Pre-built variant assets (AVIF/WebP) for the production site. Public-read,
# served directly to browsers. Sync with `pnpm assets:sync` after every
# `pnpm shrink`. Set NEXT_PUBLIC_ASSETS_BASE_URL above to this bucket's
# public URL (R2 dev URL or a custom domain) for prod builds.
# R2_ASSETS_BUCKET=collection-of-beauty-assets
