# Copy to .env.local and adjust for your setup.

# Base URL the browser uses to fetch artwork variants (pre-built AVIF/WebP
# files + originals). Defaults (in code) to the rclone HTTP server run by
# the asset HTTP server (scripts/serve-assets.mjs) on :9837. Override to
# point at R2, a public CDN, or any other HTTP file host.
NEXT_PUBLIC_ASSETS_BASE_URL=http://localhost:9837

# Canonical site URL (used for artwork links in the email and absolute URLs
# in metadata / sitemaps / JSON-LD). Falls back to a hardcoded prod URL
# (or localhost in dev) if unset.
# NEXT_PUBLIC_SITE_URL=https://collection-of-beauty.example.com

# ─────────────────────────────────────────────────────────────────────────────
# Newsletter (ListMonk + Amazon SES)
# ─────────────────────────────────────────────────────────────────────────────
# Editions live as markdown under content/newsletter/. There is no cron job
# and no /api/newsletter/send route. Sending happens via the CLI:
#   pnpm newsletter:send <slug>            # dry-run
#   pnpm newsletter:send <slug> --confirm  # → LISTMONK_TEST_LIST_ID
#   NODE_ENV=production pnpm newsletter:send <slug> --confirm  # → LISTMONK_LIST_ID
#
# Architecture:
#   - ListMonk holds subscribers, list memberships, and dispatches sends.
#   - ListMonk is configured (in its admin UI) to deliver via Amazon SES
#     SMTP — these app-level env vars are NOT used for direct SES auth;
#     SES creds live inside ListMonk's settings.
#   - The app talks to ListMonk's HTTP API: it adds subscribers for the
#     double-opt-in form, sends transactional confirmation emails through
#     /api/tx, and triggers the weekly digest via /api/campaigns.
#
# Required one-time ListMonk admin setup:
#   1. Create two lists (production + test).
#      Set LISTMONK_LIST_ID and LISTMONK_TEST_LIST_ID to their numeric ids.
#   2. Create an API user with Subscribers + Campaigns + Templates +
#      Transactional permissions.
#      Set LISTMONK_API_USER + LISTMONK_API_TOKEN.
#   3. Create a transactional template under Campaigns → Templates.
#      Subject: {{ .Tx.Data.subject }}
#      Body:
#        {{ template "content" . }}
#      Where the content block contains:
#        {{ .Tx.Data.body | safeHTML }}
#        <p style="font-size:11px;text-align:center;color:#888;margin-top:24px">
#          <a href="{{ UnsubscribeURL }}">Unsubscribe</a>
#        </p>
#      Set LISTMONK_TX_TEMPLATE_ID to its numeric id.
#   4. Create a campaign template under Campaigns → Templates.
#      Body:
#        {{ template "content" . }}
#      (The weekly-digest HTML already includes its own {{ UnsubscribeURL }}
#      footer; the template is a pure passthrough wrapper.)
#      Set LISTMONK_CAMPAIGN_TEMPLATE_ID to its numeric id.

# ListMonk admin URL (no trailing slash). API requests target $LISTMONK_URL/api/...
# LISTMONK_URL=https://listmonk.example.com

# API credentials (Settings → Users → API users in the admin UI).
# LISTMONK_API_USER=
# LISTMONK_API_TOKEN=

# Numeric list ids for the real subscriber list and the test list. The
# test list should contain only your own address. Decided by NODE_ENV.
# LISTMONK_LIST_ID=1
# LISTMONK_TEST_LIST_ID=2

# Template ids for the passthrough templates described above.
# LISTMONK_TX_TEMPLATE_ID=
# LISTMONK_CAMPAIGN_TEMPLATE_ID=

# Display from-address used for outbound campaigns. ListMonk also has its
# own default; this one wins per-send. Must be on a domain SES is allowed
# to send from.
# LISTMONK_FROM="A Drop of Beauty <hello@beauty.example.com>"

# HMAC secret for the double-opt-in confirmation tokens issued by
# /api/newsletter/subscribe. Generate with: openssl rand -hex 32
# NEWSLETTER_TOKEN_SECRET=

# Cloudflare R2 credentials — public assets bucket only (no state file
# any more; newsletter "has it been sent" lives in git via the markdown
# files in content/newsletter/).
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Pre-built variant assets (AVIF/WebP) for the production site. Public-read,
# served directly to browsers. Sync with `pnpm assets:sync` after every
# `pnpm shrink`. Set NEXT_PUBLIC_ASSETS_BASE_URL above to this bucket's
# public URL (R2 dev URL or a custom domain) for prod builds.
# R2_ASSETS_BUCKET=collection-of-beauty-assets
