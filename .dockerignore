assets
assets-web

# Local build output, served from storage (scripts/RETAINED-ASSETS.md, "Press kit")
public/press-kit.zip

# Node artifacts — installed fresh inside the image
node_modules
.next
.pnpm-store

# VCS / local tooling
.git
.gitignore
.gitattributes
.claude

# Env & secrets
.env
.env.*
!.env.example
!.env.production

# Editor / OS cruft
.vscode
.idea
.DS_Store

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Docker itself
Dockerfile*
docker-compose*.yml
.dockerignore
