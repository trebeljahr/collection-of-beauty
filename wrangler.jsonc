// collection-of-beauty: the static export in out/, served without any
// Worker code. Requests to it are not counted against the Workers quota.
//
// No `main`, no `routes`, no `cache`. Routes are made once through the
// Cloudflare API (docs/static-site.md), so a deploy never touches them:
//   collectionofbeauty.com/*                            → this Worker
//   collectionofbeauty.com/api/newsletter/*, /api/download/*
//                                                       → collection-of-beauty-api
//   collectionofbeauty.com/.well-known/acme-challenge/* → no Worker (origin)
//
// Deploys upload a version first and activate it after
// (.github/workflows/deploy.yml): a one-step deploy left seconds of 404s
// on new chunks on the canary.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "collection-of-beauty",
  "compatibility_date": "2026-09-20",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    // `/artwork/x` is out/artwork/x.html; `/artwork/x/` redirects to it.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
