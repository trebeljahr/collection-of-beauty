# Catch objectKey↔R2 drift before a push triggers a Coolify deploy.
# Replaces the old CI verify-assets gate, which false-failed on network
# blips during a 38k-key HEAD sweep. Runs only when the catalogue
# (src/data/artworks.json) is part of what's being pushed, and uses
# --bulk (one rclone LIST, in-memory membership) so it's fast, reliable,
# and doesn't hammer the CDN. git feeds pushed refs on stdin as
# "<local_ref> <local_oid> <remote_ref> <remote_oid>".
CATALOGUE="src/data/artworks.json"
ZERO="0000000000000000000000000000000000000000"
needs_verify=0

while read -r local_ref local_oid remote_ref remote_oid; do
  # Skip empty lines and branch deletions (local side is all-zeros).
  { [ -z "$local_oid" ] || [ "$local_oid" = "$ZERO" ]; } && continue
  if [ "$remote_oid" = "$ZERO" ]; then
    # New branch on the remote — diff against origin/main if we have it,
    # otherwise verify to be safe (can't tell what's new).
    base="$(git rev-parse --verify --quiet origin/main)" || base=""
  else
    base="$remote_oid"
  fi
  if [ -n "$base" ]; then
    changed="$(git diff --name-only "$base" "$local_oid" -- "$CATALOGUE")"
  else
    changed="$CATALOGUE"
  fi
  [ -n "$changed" ] && needs_verify=1
done

[ "$needs_verify" -eq 0 ] && exit 0

echo "[pre-push] $CATALOGUE changed — verifying R2 variants (bulk)…"
pnpm assets:verify:bulk
code=$?
# Exit 2 = docker/R2 creds unavailable (infra, not drift). Don't block
# the push on that; the deploy will still succeed and you can run
# `pnpm assets:verify:bulk` by hand once docker is up.
if [ "$code" -eq 2 ]; then
  echo "[pre-push] verify skipped (docker or R2 creds unavailable) — push allowed." >&2
  exit 0
fi
exit "$code"
