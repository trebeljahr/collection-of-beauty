{
  "name": "collection-of-beauty",
  "version": "0.1.0",
  "private": true,
  "description": "4,000+ handpicked public-domain artworks to browse by era, artist, colour or decade, or walk through in a 3D museum.",
  "homepage": "https://collectionofbeauty.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trebeljahr/collection-of-beauty.git"
  },
  "bugs": {
    "url": "https://github.com/trebeljahr/collection-of-beauty/issues"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Rico Trebeljahr",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "assets:build-data": "node scripts/build-data.mjs && pnpm redirects:build && pnpm assets:versions",
    "assets:versions": "node scripts/build-asset-versions.mjs",
    "redirects:build": "tsx scripts/build-redirects.ts",
    "assets:serve": "node scripts/serve-assets.mjs",
    "assets:sync": "dotenvx run -f .env.production -f .env.local --ignore=MISSING_ENV_FILE --quiet -- bash scripts/sync-assets.sh",
    "assets:verify": "node scripts/verify-r2.mjs",
    "assets:verify:bulk": "dotenvx run -f .env.production -f .env.local --ignore=MISSING_ENV_FILE --quiet -- node scripts/verify-r2.mjs --bulk",
    "assets:prepare": "pnpm assets:shrink && pnpm assets:build-data && pnpm assets:tiles && pnpm assets:sync",
    "dev": "node scripts/dev.mjs",
    "dev:r2": "NEXT_PUBLIC_ASSETS_BASE_URL=https://assets.collectionofbeauty.com node scripts/dev.mjs",
    "build": "dotenvx run -f .env.production -f .env.local --ignore=MISSING_ENV_FILE -- next build && tsx scripts/write-static-routing.mts",
    "build:analyze": "ANALYZE=true dotenvx run -f .env.production -f .env.local --ignore=MISSING_ENV_FILE -- next build",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:release": "node --test scripts/release.test.mjs scripts/press-kit.test.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "email:dev": "email dev --dir ./emails --port 3001",
    "sendNewsletter": "bash scripts/newsletter-send.sh",
    "newsletter:send": "bash scripts/newsletter-send.sh",
    "newsletter:draft": "tsx scripts/newsletter-draft.ts",
    "newsletter:check-links": "node scripts/check-newsletter-links.mjs --external",
    "listmonk:bootstrap": "dotenvx run -f .env.production -f .env.local --ignore=MISSING_ENV_FILE -- tsx scripts/listmonk-bootstrap.ts",
    "scrape:fetch": "node scripts/fetch-wikimedia-metadata.mjs",
    "scrape:resolve": "node scripts/resolve-unresolved.mjs",
    "scrape:classify": "node scripts/classify-unresolved.mjs",
    "scrape:provenance": "node scripts/fetch-provenance.mjs",
    "download:birds": "bash scripts/download-birds-of-america.sh",
    "download:kunstformen": "bash scripts/download-kunstformen.sh",
    "assets:shrink": "node scripts/shrink-sources.mjs",
    "assets:tiles": "node scripts/build-tiles.mjs",
    "music:build": "tsx scripts/build-music.ts",
    "textures": "node scripts/download-textures.mjs",
    "marketing:images": "node scripts/build-marketing-images.mjs",
    "marketing:screenshots": "node scripts/build-museum-screenshots.mjs",
    "marketing:press-kit-zip": "node scripts/build-press-kit-zip.mjs",
    "marketing:site-screenshots": "node scripts/capture-site-screenshots.mjs",
    "marketing:social-preview": "node scripts/build-social-preview.mjs",
    "marketing:manifest": "node scripts/build-marketing-manifest.mjs",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "prepare": "husky",
    "preview": "wrangler dev --port ${PORT:-49731} --local",
    "api:data": "tsx scripts/build-api-worker-data.ts",
    "api:typecheck": "tsx scripts/build-api-worker-data.ts && tsc --noEmit -p workers/api",
    "dev:api": "tsx scripts/build-api-worker-data.ts && wrangler dev -c workers/api/wrangler.jsonc --port 8790 --local",
    "collections:zips": "tsx scripts/build-collection-zips.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@hatchkit/dev-plugin-next": "^0.1.47",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.2.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@sentry/browser": "^10.78.0",
    "@three.ez/instanced-mesh": "^0.3.16",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "fuse.js": "^7.5.0",
    "gray-matter": "^4.0.3",
    "image-size": "^2.0.4",
    "joystick-controller": "^2.0.0",
    "lucide-react": "^1.66.0",
    "next": "^16.4.3",
    "openseadragon": "^6.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-photo-album": "^3.6.2",
    "react-zoom-pan-pinch": "^4.2.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "seedrandom": "^3.0.5",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "three": "^0.184.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@dotenvx/dotenvx": "^1.75.1",
    "@next/bundle-analyzer": "^16.4.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/seedrandom": "^3.0.8",
    "@types/three": "^0.184.0",
    "@vitest/coverage-v8": "^4.1.12",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.32",
    "react-email": "^6.11.6",
    "tailwindcss": "^4.3.3",
    "thumbhash": "^0.1.1",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "wrangler": "4.136.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "pnpm": {
    "overrides": {
      "fast-xml-parser@5": "5.7.0",
      "ws@7": "7.5.11",
      "ws@8": "8.21.0",
      "brace-expansion@5": "5.0.12",
      "engine.io@6": "6.6.10",
      "socket.io-parser@4": "4.2.7",
      "fast-uri@3": "3.1.8",
      "postcss@8": "8.5.28",
      "nanoid@3": "3.3.18",
      "esbuild@0.27": "0.28.1",
      "vite@8": "8.3.1",
      "esbuild@0.28": "0.28.1"
    }
  }
}
