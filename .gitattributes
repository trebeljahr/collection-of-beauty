*.jpg filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text

# App/public icons are tiny build inputs. Keep them as normal Git blobs
# so Next can decode them during `next build` even in LFS-smudge-skip
# checkouts.
src/app/icon.png !filter !diff !merge -text
src/app/apple-icon.png !filter !diff !merge -text
src/app/opengraph-image.png !filter !diff !merge -text
public/favicon.png !filter !diff !merge -text
public/apple-touch-icon.png !filter !diff !merge -text
public/marketing/hero.png !filter !diff !merge -text
public/marketing/hero.jpg !filter !diff !merge -text

# Poly Haven PBR textures are small (≤2 MB each, ~18 MB total) and
# CC0, so we ship them as regular Git blobs rather than LFS objects.
# Without this exception they get LFS-cleaned on commit and the local
# clone gets 131-byte pointer files at checkout (the repo configures
# `smudge --skip`), which the dev server happily serves with
# Content-Type: image/jpeg — three.js then can't decode them and the
# 3D gallery falls back to mirror-finish floors reflecting the env map.
public/textures/**/*.jpg !filter !diff !merge -text
